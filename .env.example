# PostFlowX — non-secret deployment configuration.
# Copy to `.env`. NEVER put secrets here: they live in ./secrets/ (see scripts/init-secrets.sh).

# --- Release pinning -------------------------------------------------------
# Production deployments must pin an exact version (never "latest").
POSTFLOWX_VERSION=dev

# --- Mode ------------------------------------------------------------------
# production  : mTLS between web and server is mandatory; refuses insecure settings.
# development : relaxed logging/validation. Still no insecure IPC unless explicitly enabled in server config.
POSTFLOWX_MODE=production
POSTFLOWX_LOG_LEVEL=info

# --- Public access ---------------------------------------------------------
# Externally visible base URL (used for OAuth redirect URIs and signed media URLs).
# Instagram requires HTTPS here in production.
POSTFLOWX_PUBLIC_BASE_URL=http://localhost:8080
# Default binds to localhost only. Set 0.0.0.0 deliberately, or use the "tls" profile.
POSTFLOWX_HTTP_BIND=127.0.0.1
POSTFLOWX_HTTP_PORT=8080
# Only needed for the optional TLS reverse proxy (docker compose --profile tls up)
POSTFLOWX_DOMAIN=

# --- Database (names only; the password is a secret file) -------------------
POSTFLOWX_DB_NAME=postflowx
POSTFLOWX_DB_USER=postflowx

# --- Resource limits (defaults, tune per host) ------------------------------
POSTFLOWX_SERVER_MEM=1g
POSTFLOWX_WEB_MEM=512m
